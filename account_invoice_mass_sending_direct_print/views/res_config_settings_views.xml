<odoo>
    <record id="res_config_settings_view_form_inherit_my_module" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.my.module</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='companies_setting_container']" position="inside">
                <div id="invoice_print" class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="invoice_is_direct_print" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="invoice_is_direct_print" />
                        <div class="text-muted">
                            Allows the invoice to be printed automatically via a background job when using the `Send &amp; Print` wizard.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
